.SUBCKT RingInverterMkII _net0 _net1 _net2 _net5 _net6 
X29 _net2  _net1  _net3  0 nfet_03v3 L=0.28u W=2.50u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
X28 _net4  _net1  _net2  _net0 pfet_03v3 L=0.28u W=10.00u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
X30 _net0  _net5  _net4  _net0 pfet_03v3 L=0.28u W=10.00u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
X31 _net3  _net6  0  0 nfet_03v3 L=0.28u W=2.50u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XC1 _net2  0 cap_mim_2f0fF c_width=2u c_length=5u
.ENDS
.SUBCKT RingInverterMkI _net0 _net1 _net2 
X29 _net2  _net1  0  0 nfet_03v3 L=0.28u W=2.50u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
X28 _net0  _net1  _net2  _net0 pfet_03v3 L=0.28u W=10.00u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XC1 _net2  0 cap_mim_2f0fF c_width=7u c_length=5u
.ENDS
.SUBCKT RingOscillatorMkII _net0 _net2 _net1 _net3 _net4 
XSUB1 _net0 _net3 _net5 _net6 _net4 RingInverterMkII
XSUB2 _net0 _net5 _net7 _net6 _net4 RingInverterMkII
XSUB3 _net0 _net7 _net3 _net6 _net4 RingInverterMkII
XSUB4 _net0 _net3 _net2 RingInverterMkI
XSUB5 _net0 _net2 _net1 RingInverterMkI
X3 _net0  _net6  _net6  _net0 pfet_03v3 L=0.28u W=10.00u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
X4 _net6  _net4  0  0 nfet_03v3 L=0.28u W=2.50u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
.ENDS
R1 0 pos  10000 tc1=0.0 tc2=0.0 
R2 0 neg  10000 tc1=0.0 tc2=0.0 
C4 neg_dc neg  10P 
C3 pos_dc pos  10P 
V1 _net0 0 DC 3.3
X1 _net1  _net1  0  0 nfet_03v3 L=0.28u W=2.50u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)' ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
I1 _net0 _net1 DC 2000U
XSUB1 _net0 pos_dc neg_dc _net2 _net1 RingOscillatorMkII







.control

tran 5e-11 1e-06 0
set specwindow=hanning
linearize v(neg) v(neg_dc) v(pos) v(pos_dc) 
fft v(neg) v(neg_dc) v(pos) v(pos_dc) 
write spice4qucs.fft1.plot v(neg) v(neg_dc) v(pos) v(pos_dc)
destroy all
reset

exit
.endc
.END
